# ===== LLM 配置 =====
# 模式：fake（默认，离线演示，无需密钥）/ openai（接入真实大模型）
LLM_MODE=fake
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ===== 向量召回配置 =====
# local（默认，纯 numpy TF-IDF，零依赖）/ milvus（生产，配合 docker-compose）
EMBEDDING_MODE=local
MILVUS_HOST=
MILVUS_PORT=19530

# ===== 缓存 / 会话 =====
# 演示用内存；生产可填 Redis 地址
REDIS_URL=

# ===== 检索阈值 =====
# 双路召回 Top1 归一化置信度低于该值 → 判定"知识库无确切答案"，触发拒答
FAQ_THRESHOLD=0.85

# ===== 服务 =====
PORT=8000
